{
  "name": "password-vault",
  "productName": "Password Vault",
  "version": "1.27.0",
  "description": "A simple, offline, encrypted password manager for Mac and Windows.",
  "main": "src/main.js",
  "author": "Matt",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/vault.test.js && node test/sync.test.js && node test/reminders-merge.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "icons": "node scripts/build-brand-icons.js",
    "logos": "electron scripts/fetch-brand-logos.js",
    "customlogos": "electron scripts/make-custom-logos.js",
    "icon:mac": "electron scripts/make-mac-icon.js"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pdfjs-dist": "^3.11.174",
    "simple-icons": "^13.21.0"
  },
  "build": {
    "appId": "com.matt.passwordvault",
    "productName": "Password Vault",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "hibbertmatt4",
      "repo": "password-vault",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "Password-Vault-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon-mac.png",
      "extendInfo": {
        "NSAppSleepDisabled": true
      },
      "artifactName": "Password-Vault-${version}-mac.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
